{
  "name": "homemart4u-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx next dev -p 10000",
    "build": "npx prisma generate && npx next build",
    "start": "npx next start -p 10000",
    "lint": "npx next lint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "node prisma/seed.cjs",
    "db:reset": "node scripts/controlled-reset.cjs",
    "prisma:clean-reset": "node scripts/controlled-reset.cjs --confirm"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.2.1",
    "prisma": "^6.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  }
}
